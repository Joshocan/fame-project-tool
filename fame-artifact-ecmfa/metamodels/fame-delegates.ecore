<?xml version="1.0" encoding="UTF-8"?>
<!--
  GENERATED by tools/make_delegates.py from fame.ecore + constraints.ocl.
  Do not edit by hand; edit constraints.ocl and regenerate.
  NOT YET VERIFIED IN ECLIPSE - see README, 'Verifying the delegate metamodel'.
-->
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="fame" nsURI="http://fame/1.0" nsPrefix="fame">

  <!-- ============================================================ -->
  <!-- CORE METAMODEL                                                -->
  <!-- ============================================================ -->
  <eSubpackages name="core" nsURI="http://fame/core/1.0" nsPrefix="famecore">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="validationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"/>
    </eAnnotations>

    <!-- Root: trust-bearing element -->
    <eClassifiers xsi:type="ecore:EClass" name="ModelElement" abstract="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="A2_NonEmptyName B1_EverythingJustified B2_BoundedConfidence B3_PrimaryEvidence C1_ConsistentCounting C2_ContradictionCapsConfidence C3_HighConfidenceNeedsCorroboration T1_TrustedMeansEvidenced"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="A2_NonEmptyName" value="self.name &lt;&gt; null and self.name.size() &gt; 0"/>
        <details key="B1_EverythingJustified" value="self.justifiedBy-&gt;size() &gt;= 1"/>
        <details key="B2_BoundedConfidence" value="self.confidence &gt;= 0.0 and self.confidence &lt;= 1.0"/>
        <details key="B3_PrimaryEvidence" value="self.justifiedBy-&gt;exists(p | p.role = ProvenanceRole::primary)"/>
        <details key="C1_ConsistentCounting" value="self.corroborationCount &gt;= 0 and self.corroborationCount &gt;= self.justifiedBy-&gt;select(p | p.role &lt;&gt; ProvenanceRole::contradicting)-&gt;collect(p | p.evidence)-&gt;asSet()-&gt;size()"/>
        <details key="C2_ContradictionCapsConfidence" value="self.justifiedBy-&gt;exists(p | p.role = ProvenanceRole::contradicting) implies self.confidence &lt; 1.0"/>
        <details key="C3_HighConfidenceNeedsCorroboration" value="self.confidence &gt;= 0.8 implies self.corroborationCount &gt;= 2"/>
        <details key="T1_TrustedMeansEvidenced" value="self.status = TrustStatus::trusted implies (self.justifiedBy-&gt;size() &gt;= 1 and self.justifiedBy-&gt;exists(p | p.role = ProvenanceRole::primary) and self.confidence &gt;= 0.0 and self.confidence &lt;= 1.0 and self.corroborationCount &gt;= 0)"/>
      </eAnnotations>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="confidence" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="corroborationCount" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="status" lowerBound="1"
          eType="#//core/TrustStatus" defaultValueLiteral="candidate"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="justifiedBy" lowerBound="1"
          upperBound="-1" eType="#//core/ProvenanceLink" containment="true"/>
    </eClassifiers>

    <!-- Provenance support types (NOT ModelElements) -->
    <eClassifiers xsi:type="ecore:EClass" name="ProvenanceLink">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="role" lowerBound="1"
          eType="#//core/ProvenanceRole"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="evidence" lowerBound="1"
          eType="#//core/SourceArtefact"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="SourceArtefact">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="uri" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1"
          eType="#//core/ArtefactKind"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="excerpt"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eClassifiers>

    <!-- Layer supertypes -->
    <eClassifiers xsi:type="ecore:EClass" name="StructuralElement" abstract="true"
        eSuperTypes="#//core/ModelElement"/>
    <eClassifiers xsi:type="ecore:EClass" name="BehaviouralElement" abstract="true"
        eSuperTypes="#//core/ModelElement"/>

    <!-- Structural layer -->
    <eClassifiers xsi:type="ecore:EClass" name="SystemModel" eSuperTypes="#//core/StructuralElement">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="A1_UniqueIds A3_LocalEndpoints"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="A1_UniqueIds" value="self-&gt;asSet()-&gt;closure(e | e.oclContents()-&gt;selectByKind(ModelElement))-&gt;including(self)-&gt;isUnique(e | e.id)"/>
        <details key="A3_LocalEndpoints" value="self.relationships-&gt;forAll(r | self-&gt;asSet()-&gt;closure(e | e.oclContents()-&gt;selectByKind(ModelElement))-&gt;including(self)-&gt;includes(r.source) and self-&gt;asSet()-&gt;closure(e | e.oclContents()-&gt;selectByKind(ModelElement))-&gt;including(self)-&gt;includes(r.target))"/>
      </eAnnotations>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="scope"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="components" upperBound="-1"
          eType="#//core/Component" containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="concepts" upperBound="-1"
          eType="#//core/DataConcept" containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="relationships" upperBound="-1"
          eType="#//core/Relationship" containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="constraintRules" upperBound="-1"
          eType="#//core/ConstraintRule" containment="true"/>
      <!-- serialization home for evidence sources; see README note -->
      <eStructuralFeatures xsi:type="ecore:EReference" name="artefacts" upperBound="-1"
          eType="#//core/SourceArtefact" containment="true"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="Component" eSuperTypes="#//core/StructuralElement">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1"
          eType="#//core/ComponentKind"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="exposes" upperBound="-1"
          eType="#//core/Interface" containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="provides" upperBound="-1"
          eType="#//core/Capability" containment="true"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="Interface" eSuperTypes="#//core/StructuralElement">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1"
          eType="#//core/InterfaceKind"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="exchanges" upperBound="-1"
          eType="#//core/DataConcept"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="DataConcept" eSuperTypes="#//core/StructuralElement">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1"
          eType="#//core/ConceptKind"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="attributes" upperBound="-1"
          eType="#//core/Attribute" containment="true"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="Attribute" eSuperTypes="#//core/StructuralElement">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="A5_OwnedAttribute"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="A5_OwnedAttribute" value="self.oclContainer().oclIsKindOf(DataConcept)"/>
      </eAnnotations>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="datatype"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="optional" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="Relationship" eSuperTypes="#//core/StructuralElement">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="A6_TypeConsistentSpecialization"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="A6_TypeConsistentSpecialization" value="self.kind = RelationKind::specialization implies self.source.oclType() = self.target.oclType()"/>
      </eAnnotations>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1"
          eType="#//core/RelationKind"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="source" lowerBound="1"
          eType="#//core/ModelElement"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1"
          eType="#//core/ModelElement"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="ConstraintRule" eSuperTypes="#//core/StructuralElement">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="D1_FormalHasExpression D2_TargetsExist"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="D1_FormalHasExpression" value="self.formal implies (self.expression &lt;&gt; null and self.expression.size() &gt; 0)"/>
        <details key="D2_TargetsExist" value="self.constrains-&gt;forAll(e | e.oclContainer() &lt;&gt; null or e.oclIsKindOf(SystemModel))"/>
      </eAnnotations>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1"
          eType="#//core/ConstraintKind"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="expression" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="formal" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="constrains" lowerBound="1"
          upperBound="-1" eType="#//core/ModelElement"/>
    </eClassifiers>

    <!-- Behavioural layer -->
    <eClassifiers xsi:type="ecore:EClass" name="Capability" eSuperTypes="#//core/BehaviouralElement">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1"
          eType="#//core/CapabilityKind"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="decomposesInto" upperBound="-1"
          eType="#//core/Operation" containment="true"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="Operation" eSuperTypes="#//core/BehaviouralElement">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="verb"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="readsOrWrites" upperBound="-1"
          eType="#//core/DataConcept"/>
    </eClassifiers>

    <!-- Closed enumerations (framework semantics) -->
    <eClassifiers xsi:type="ecore:EEnum" name="TrustStatus">
      <eLiterals name="candidate" value="0"/>
      <eLiterals name="validated" value="1"/>
      <eLiterals name="trusted" value="2"/>
      <eLiterals name="rejected" value="3"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="ProvenanceRole">
      <eLiterals name="primary" value="0"/>
      <eLiterals name="corroborating" value="1"/>
      <eLiterals name="contradicting" value="2"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="RelationKind">
      <eLiterals name="association" value="0"/>
      <eLiterals name="dependency" value="1"/>
      <eLiterals name="composition" value="2"/>
      <eLiterals name="specialization" value="3"/>
      <eLiterals name="dataflow" value="4"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="ConstraintKind">
      <eLiterals name="invariant" value="0"/>
      <eLiterals name="precondition" value="1"/>
      <eLiterals name="postcondition" value="2"/>
      <eLiterals name="cardinality" value="3"/>
      <eLiterals name="uniqueness" value="4"/>
    </eClassifiers>

    <!-- Extensible enumerations (vocabulary plug-in point: regenerated per domain) -->
    <eClassifiers xsi:type="ecore:EEnum" name="ComponentKind">
      <eLiterals name="system" value="0"/>
      <eLiterals name="service" value="1"/>
      <eLiterals name="module" value="2"/>
      <eLiterals name="externalActor" value="3"/>
      <eLiterals name="store" value="4"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="ConceptKind">
      <eLiterals name="entity" value="0"/>
      <eLiterals name="valueObject" value="1"/>
      <eLiterals name="event" value="2"/>
      <eLiterals name="document" value="3"/>
      <eLiterals name="identifier" value="4"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="InterfaceKind">
      <eLiterals name="rest" value="0"/>
      <eLiterals name="rpc" value="1"/>
      <eLiterals name="graphql" value="2"/>
      <eLiterals name="messaging" value="3"/>
      <eLiterals name="eventStream" value="4"/>
      <eLiterals name="fileExchange" value="5"/>
      <eLiterals name="ui" value="6"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="CapabilityKind">
      <eLiterals name="create" value="0"/>
      <eLiterals name="read" value="1"/>
      <eLiterals name="update" value="2"/>
      <eLiterals name="delete" value="3"/>
      <eLiterals name="transform" value="4"/>
      <eLiterals name="notify" value="5"/>
      <eLiterals name="orchestrate" value="6"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="ArtefactKind">
      <eLiterals name="apiDoc" value="0"/>
      <eLiterals name="schema" value="1"/>
      <eLiterals name="requirement" value="2"/>
      <eLiterals name="manual" value="3"/>
      <eLiterals name="workflowDoc" value="4"/>
      <eLiterals name="integrationGuide" value="5"/>
      <eLiterals name="profile" value="6"/>
      <eLiterals name="log" value="7"/>
    </eClassifiers>
  </eSubpackages>

  <!-- ============================================================ -->
  <!-- CORRESPONDENCE METAMODEL                                      -->
  <!-- ============================================================ -->
  <eSubpackages name="correspondence" nsURI="http://fame/correspondence/1.0"
      nsPrefix="famecorr">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="validationDelegates" value="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"/>
    </eAnnotations>

    <eClassifiers xsi:type="ecore:EClass" name="CorrespondenceModel">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="E1_RelatesTwoModels G1_InternalConsistency"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="E1_RelatesTwoModels" value="self.relates-&gt;size() &gt;= 2 and self.relates-&gt;isUnique(p | p.ref)"/>
        <details key="G1_InternalConsistency" value="self.correspondences-&gt;forAll(c1, c2 | (c1 &lt;&gt; c2 and c1.ends-&gt;collect(e | Tuple{m = e.inModel.ref, el = e.elementRef})-&gt;asSet() = c2.ends-&gt;collect(e | Tuple{m = e.inModel.ref, el = e.elementRef})-&gt;asSet()) implies not (Set{c1.kind, c2.kind} = Set{CorrespondenceKind::equivalence, CorrespondenceKind::mismatch}))"/>
      </eAnnotations>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="scope"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="relates" lowerBound="2"
          upperBound="-1" eType="#//correspondence/ParticipatingModel" containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="correspondences" upperBound="-1"
          eType="#//correspondence/Correspondence" containment="true"/>
      <!-- serialization home for correspondence-level evidence -->
      <eStructuralFeatures xsi:type="ecore:EReference" name="artefacts" upperBound="-1"
          eType="#//core/SourceArtefact" containment="true"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="ParticipatingModel">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="ref" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="alias"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eClassifiers>

    <!-- Correspondence is a trust-bearing ModelElement -->
    <eClassifiers xsi:type="ecore:EClass" name="Correspondence"
        eSuperTypes="#//core/ModelElement">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="constraints" value="E2_AtLeastTwoEnds E3_CrossesModels E4_DistinctEndpoints E6_DirectionMatchesKind E7_RolesIffDirected E7b_NoRolesIfUndirected"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="E2_AtLeastTwoEnds" value="self.ends-&gt;size() &gt;= 2"/>
        <details key="E3_CrossesModels" value="self.ends-&gt;collect(e | e.inModel)-&gt;asSet()-&gt;size() &gt;= 2"/>
        <details key="E4_DistinctEndpoints" value="self.ends-&gt;isUnique(e | Tuple{m = e.inModel.ref, el = e.elementRef})"/>
        <details key="E6_DirectionMatchesKind" value="(Set{CorrespondenceKind::refinement, CorrespondenceKind::generalization, CorrespondenceKind::dependency}-&gt;includes(self.kind)) = self.directed"/>
        <details key="E7_RolesIffDirected" value="self.directed implies self.ends-&gt;forAll(e | e.role &lt;&gt; null)"/>
        <details key="E7b_NoRolesIfUndirected" value="(not self.directed) implies self.ends-&gt;forAll(e | e.role = null)"/>
      </eAnnotations>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1"
          eType="#//correspondence/CorrespondenceKind"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="directed" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="ends" lowerBound="2"
          upperBound="-1" eType="#//correspondence/CorrespondenceEnd" containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="conditionedBy" upperBound="-1"
          eType="#//correspondence/CompatibilityCondition" containment="true"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="CorrespondenceEnd">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="elementRef" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="role"
          eType="#//correspondence/EndRole" unsettable="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="inModel" lowerBound="1"
          eType="#//correspondence/ParticipatingModel"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EClass" name="CompatibilityCondition">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="expression" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="formal" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="mustHold" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    </eClassifiers>

    <eClassifiers xsi:type="ecore:EEnum" name="CorrespondenceKind">
      <eLiterals name="equivalence" value="0"/>
      <eLiterals name="refinement" value="1"/>
      <eLiterals name="overlap" value="2"/>
      <eLiterals name="mismatch" value="3"/>
      <eLiterals name="dependency" value="4"/>
      <eLiterals name="generalization" value="5"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="EndRole">
      <eLiterals name="abstracted" value="0"/>
      <eLiterals name="refined" value="1"/>
      <eLiterals name="required" value="2"/>
      <eLiterals name="dependent" value="3"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>
