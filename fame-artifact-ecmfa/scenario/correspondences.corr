models gp = M1  lab = M2  ehr = M3

C1 : mismatch
    gp::Practitioner ~ ehr::Clinician
    when 'actor roles must be reconciled before any actor-level exchange' must
    evidence   A9_role_analysis, A8_hl7_mapping
    confidence 0.82
    status     trusted

C2 : refinement
    gp::LabRequest[abstracted] -> lab::TestOrder[refined], lab::Specimen[refined]
    when 'specimen identity must be preserved across the split' must
    evidence   A8_hl7_mapping, A9_role_analysis
    confidence 0.84
    status     validated

C3 : equivalence
    gp::RequestedTest ~ lab::LaboratoryTest
    evidence   A8_hl7_mapping, A9_role_analysis
    confidence 0.91
    status     trusted

C4 : equivalence
    gp::Patient ~ lab::SubjectOfCare ~ ehr::PatientRecord
    when 'national identifier present on all three records' must
    evidence   A10_patient_id_note, A8_hl7_mapping, A9_role_analysis
    confidence 0.95
    status     trusted

C5 : equivalence
    lab::ValidatedTest ~ ehr::Observation
    when 'Observation must be contained in a DiagnosticReport' must
    evidence   A8_hl7_mapping, A9_role_analysis
    confidence 0.87
    status     trusted

